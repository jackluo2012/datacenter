syntax = "v1"

//系统管理 RBAC 网关编排（对标 RuoYi：用户/角色/菜单/按钮权限/动态路由）
//类型与 sys/rpc/sys.proto 对齐；GET 用 optional+form（query 传参），POST 用 json-only；列表分页 page/size 同既有服务

// ============ 用户管理 ============
type SysUserInfo {
	Id        int64   `json:"id,optional"`
	Username  string  `json:"username,optional"` //登录名
	Nickname  string  `json:"nickname,optional"`
	Mobile    string  `json:"mobile,optional"`
	Email     string  `json:"email,optional"`
	Status    int32   `json:"status,optional"` //1.启用 0.停用
	Remark    string  `json:"remark,optional"`
	CreatedAt int64   `json:"created_at,optional"`
	RoleIds   []int64 `json:"role_ids,optional"` //用户角色
}
type SysUserResp {
	User SysUserInfo `json:"user"`
}
type SysUserCreateReq {
	Username string  `json:"username"`
	Password string  `json:"password"`
	Nickname string  `json:"nickname,optional"`
	Mobile   string  `json:"mobile,optional"`
	Email    string  `json:"email,optional"`
	Remark   string  `json:"remark,optional"`
	RoleIds  []int64 `json:"role_ids,optional"`
	Beid     int64   `json:"beid,optional"` //缺省取 JWT ctx 中的 beid
}
type SysUserUpdateReq {
	Id       int64   `json:"id"`
	Nickname string  `json:"nickname,optional"`
	Mobile   string  `json:"mobile,optional"`
	Email    string  `json:"email,optional"`
	Status   int32   `json:"status,optional"`
	Remark   string  `json:"remark,optional"`
	Password string  `json:"password,optional"` //空=不修改
	RoleIds  []int64 `json:"role_ids,optional"`
	Beid     int64   `json:"beid,optional"`
}
type SysUserIdReq {
	Id   int64 `json:"id,optional" form:"id,optional"`
	Beid int64 `json:"beid,optional" form:"beid,optional"`
}
type SysUserListReq {
	Beid    int64  `json:"beid,optional" form:"beid,optional"`
	Keyword string `json:"keyword,optional" form:"keyword,optional"` //username/nickname/mobile
	Status  int32  `json:"status,optional" form:"status,optional"`
	Page    int64  `json:"page,optional" form:"page,optional"`
	Size    int64  `json:"size,optional" form:"size,optional"`
}
type SysUserListResp {
	List  []SysUserInfo `json:"list"`
	Total int64         `json:"total"`
}
type SysUserResetPwdReq {
	Id       int64  `json:"id"`
	Password string `json:"password"`
	Beid     int64  `json:"beid,optional"`
}

// ============ 角色管理 ============
type SysRoleInfo {
	Id       int64   `json:"id,optional"`
	RoleKey  string  `json:"role_key,optional"` //权限字符(如 admin/operator)
	RoleName string  `json:"role_name,optional"`
	Status   int32   `json:"status,optional"` //1.启用 0.停用
	Remark   string  `json:"remark,optional"`
	Beid     int64   `json:"beid,optional"`
	MenuIds  []int64 `json:"menu_ids,optional"` //角色菜单
}
type SysRoleResp {
	Role SysRoleInfo `json:"role"`
}
type SysRoleSaveReq {
	Id       int64   `json:"id,optional"` //0 新建
	RoleKey  string  `json:"role_key"`
	RoleName string  `json:"role_name"`
	Status   int32   `json:"status,optional"`
	Remark   string  `json:"remark,optional"`
	MenuIds  []int64 `json:"menu_ids,optional"`
	Beid     int64   `json:"beid,optional"`
}
type SysRoleIdReq {
	Id   int64 `json:"id,optional" form:"id,optional"`
	Beid int64 `json:"beid,optional" form:"beid,optional"`
}
type SysRoleListReq {
	Beid    int64  `json:"beid,optional" form:"beid,optional"`
	Keyword string `json:"keyword,optional" form:"keyword,optional"`
	Page    int64  `json:"page,optional" form:"page,optional"`
	Size    int64  `json:"size,optional" form:"size,optional"`
}
type SysRoleListResp {
	List  []SysRoleInfo `json:"list"`
	Total int64         `json:"total"`
}

// ============ 菜单管理 ============
type SysMenuInfo {
	Id        int64         `json:"id,optional"`
	ParentId  int64         `json:"parent_id,optional"` //0 根
	Name      string        `json:"name,optional"`      //菜单名
	Path      string        `json:"path,optional"`      //前端路由路径(如 /datasource)
	Component string        `json:"component,optional"` //前端组件路径
	Sort      int32         `json:"sort,optional"`
	Icon      string        `json:"icon,optional"`    //element 图标名
	MenuType  int32         `json:"menu_type,optional"` //1.目录 2.菜单 3.按钮
	Perm      string        `json:"perm,optional"`    //按钮权限标识(如 datasource:create)
	Visible   int32         `json:"visible,optional"` //1.显示 0.隐藏
	Beid      int64         `json:"beid,optional"`
	Children  []SysMenuInfo `json:"children,optional"` //树形返回
}
type SysMenuResp {
	Menu SysMenuInfo `json:"menu"`
}
type SysMenuSaveReq {
	Id        int64  `json:"id,optional"` //0 新建
	ParentId  int64  `json:"parent_id,optional"`
	Name      string `json:"name"`
	Path      string `json:"path,optional"`
	Component string `json:"component,optional"`
	Sort      int32  `json:"sort,optional"`
	Icon      string `json:"icon,optional"`
	MenuType  int32  `json:"menu_type"`
	Perm      string `json:"perm,optional"`
	Visible   int32  `json:"visible,optional"`
	Beid      int64  `json:"beid,optional"`
}
type SysMenuIdReq {
	Id   int64 `json:"id,optional" form:"id,optional"`
	Beid int64 `json:"beid,optional" form:"beid,optional"`
}
type SysMenuTreeReq {
	Beid int64 `json:"beid,optional" form:"beid,optional"`
}
type SysMenuTreeResp {
	List []SysMenuInfo `json:"list"`
}

// ============ 登录增强（uid/beid 由网关从 JWT ctx 注入） ============
type SysGetInfoResp {
	Uid      int64         `json:"uid,optional"`
	Username string        `json:"username,optional"`
	Nickname string        `json:"nickname,optional"`
	Roles    []string      `json:"roles,optional"` //角色 key 集
	Perms    []string      `json:"perms,optional"` //按钮权限标识集
	Menus    []SysMenuInfo `json:"menus,optional"` //菜单树(目录+菜单，不含按钮)
}
type SysRouterBranch {
	Name      string            `json:"name,optional"`
	Path      string            `json:"path,optional"`
	Component string            `json:"component,optional"`
	Icon      string            `json:"icon,optional"`
	Children  []SysRouterBranch `json:"children,optional"`
}
type SysRoutersResp {
	Routers []SysRouterBranch `json:"routers"`
}

@server(
	jwt:   Auth
	group: sys
)
service datacenter-api {
	//用户管理
	@handler sysUserCreate
	post /sys/user/create (SysUserCreateReq) returns (SysUserResp)
	@handler sysUserUpdate
	post /sys/user/update (SysUserUpdateReq) returns (SysUserResp)
	@handler sysUserDelete
	post /sys/user/delete (SysUserIdReq)
	@handler sysUserList
	get /sys/user/list (SysUserListReq) returns (SysUserListResp)
	@handler sysUserInfo
	get /sys/user/info (SysUserIdReq) returns (SysUserResp)
	@handler sysUserResetpwd
	post /sys/user/resetpwd (SysUserResetPwdReq)
	//角色管理
	@handler sysRoleCreate
	post /sys/role/create (SysRoleSaveReq) returns (SysRoleResp)
	@handler sysRoleUpdate
	post /sys/role/update (SysRoleSaveReq) returns (SysRoleResp)
	@handler sysRoleDelete
	post /sys/role/delete (SysRoleIdReq)
	@handler sysRoleList
	get /sys/role/list (SysRoleListReq) returns (SysRoleListResp)
	@handler sysRoleInfo
	get /sys/role/info (SysRoleIdReq) returns (SysRoleResp)
	//菜单管理
	@handler sysMenuSave
	post /sys/menu/save (SysMenuSaveReq) returns (SysMenuResp)
	@handler sysMenuDelete
	post /sys/menu/delete (SysMenuIdReq)
	@handler sysMenuTree
	get /sys/menu/tree (SysMenuTreeReq) returns (SysMenuTreeResp)
	//登录增强（当前登录用户）
	@handler sysGetinfo
	get /sys/getinfo () returns (SysGetInfoResp)
	@handler sysGetrouters
	get /sys/getrouters () returns (SysRoutersResp)
}

//管理台登录（不走 JWT，成功后签发）
type SysLoginReq {
	Username string `json:"username"`
	Password string `json:"password"`
	Beid     int64  `json:"beid,optional"`
}
type SysLoginResp {
	Token    string   `json:"token"`
	Uid      int64    `json:"uid"`
	Username string   `json:"username"`
	Nickname string   `json:"nickname,optional"`
	Roles    []string `json:"roles"`
	Perms    []string `json:"perms"`
}

@server(
	group: sys
)
service datacenter-api {
	@doc(
		summary: "管理台登录"
	)
	@handler sysLogin
	post /sys/login (SysLoginReq) returns (SysLoginResp)
}
