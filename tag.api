syntax = "v1"

type TagGroupInfo {
	Id                int64  `json:"id,optional"`
	Name              string `json:"name,optional"`
	ObjectId          int64  `json:"object_id,optional"`
	CircleRuleSql     string `json:"circle_rule_sql,optional"`
	EstCount          int64  `json:"est_count,optional"`
	MaterializedTable string `json:"materialized_table,optional"`
	LastRunAt         int64  `json:"last_run_at,optional"`
}
type CreateTagGroupReq {
	Name          string `json:"name"`
	ObjectId      int64  `json:"object_id"`
	CircleRuleSql string `json:"circle_rule_sql"`
	Beid          int64  `json:"beid,optional"`
}
type TagGroupListReq {
	Beid int64 `json:"beid,optional" form:"beid,optional"`
	Page int64 `json:"page,optional" form:"page,optional"`
	Size int64 `json:"size,optional" form:"size,optional"`
}
type RunTagCircleReq {
	GroupId int64 `json:"group_id"`
	Beid    int64 `json:"beid,optional"`
}
type RunTagCircleResp {
	MemberCount int64  `json:"member_count"`
	Msg         string `json:"msg,optional"`
}
type GroupMembersReq {
	GroupId int64 `json:"group_id,optional" form:"group_id,optional"`
	Beid    int64 `json:"beid,optional" form:"beid,optional"`
	Page    int64 `json:"page,optional" form:"page,optional"`
	Size    int64 `json:"size,optional" form:"size,optional"`
}
type GroupMember {
	ObjectPk string `json:"object_pk,optional"`
	TagValue string `json:"tag_value,optional"`
}
type GroupMembersResp {
	Members []GroupMember `json:"members"`
	Total   int64         `json:"total"`
}

type TagGroupListResp {
	List  []TagGroupInfo `json:"list"`
	Total int64          `json:"total"`
}

//数据标签（Phase 2）
type TagObject {
	Id        int64  `json:"id,optional"`
	ObjectType string `json:"object_type,optional"`
	Name      string `json:"name,optional"`
	DsId      int64  `json:"ds_id,optional"`
	DbName    string `json:"db_name,optional"`
	TableName string `json:"table_name,optional"`
	PkColumn  string `json:"pk_column,optional"`
	Beid      int64  `json:"beid,optional"`
}

type CreateTagObjectReq {
	ObjectType string `json:"object_type"`
	Name       string `json:"name"`
	DsId       int64  `json:"ds_id,optional"`
	DbName     string `json:"db_name,optional"`
	TableName  string `json:"table_name,optional"`
	PkColumn   string `json:"pk_column,optional"`
	Beid       int64  `json:"beid,optional"`
}

type TagObjectListReq {
	Beid       int64  `json:"beid,optional" form:"beid,optional"`
	ObjectType string `json:"object_type,optional" form:"object_type,optional"`
	Page       int64  `json:"page,optional" form:"page,optional"`
	Size       int64  `json:"size,optional" form:"size,optional"`
}
type TagObjectListResp {
	List  []TagObject `json:"list"`
	Total int64       `json:"total"`
}

type TagDef {
	Id         int64  `json:"id,optional"`
	ObjectId   int64  `json:"object_id,optional"`
	TagKey     string `json:"tag_key,optional"`
	TagName    string `json:"tag_name,optional"`
	TagType    string `json:"tag_type,optional"`
	RuleSql    string `json:"rule_sql,optional"`
	RefreshCron string `json:"refresh_cron,optional"`
	Status     int32  `json:"status,optional"`
	Beid       int64  `json:"beid,optional"`
	ObjectName string `json:"object_name,optional"` //所属对象名（列表回显）
}

type CreateTagDefReq {
	ObjectId   int64  `json:"object_id"`
	TagKey     string `json:"tag_key"`
	TagName    string `json:"tag_name"`
	TagType    string `json:"tag_type,optional"`
	RuleSql    string `json:"rule_sql,optional"`
	RefreshCron string `json:"refresh_cron,optional"`
	Beid       int64  `json:"beid,optional"`
}

type UpdateTagDefReq {
	Id          int64  `json:"id"`
	ObjectId    int64  `json:"object_id"`
	TagKey      string `json:"tag_key"`
	TagName     string `json:"tag_name"`
	TagType     string `json:"tag_type"`
	RuleSql     string `json:"rule_sql,optional"`
	RefreshCron string `json:"refresh_cron,optional"`
	Status      int32  `json:"status"` //1.启用 0.停用（全量更新契约，必传）
	Beid        int64  `json:"beid,optional"`
}

type TagDefIdReq {
	Id   int64 `json:"id,optional" form:"id,optional"`
	Beid int64 `json:"beid,optional" form:"beid,optional"`
}

type TagDefListReq {
	Beid     int64 `json:"beid,optional" form:"beid,optional"`
	ObjectId int64 `json:"object_id,optional" form:"object_id,optional"`
	Page     int64 `json:"page,optional" form:"page,optional"`
	Size     int64 `json:"size,optional" form:"size,optional"`
}
type TagDefListResp {
	List  []TagDef `json:"list"`
	Total int64    `json:"total"`
}

type TaggingReq {
	TagId    int64 `json:"tag_id,optional"`
	ObjectId int64 `json:"object_id,optional"`
	Beid     int64 `json:"beid,optional"`
}
type TaggingResp {
	TaggedRows int64 `json:"tagged_rows"`
	TagId      int64 `json:"tag_id"`
}

type ObjectTagsReq {
	ObjectPk string `json:"object_pk,optional" form:"object_pk,optional"`
	ObjectId int64  `json:"object_id,optional" form:"object_id,optional"`
	Beid     int64  `json:"beid,optional" form:"beid,optional"`
}
type TagValueItem {
	TagKey   string `json:"tag_key,optional"`
	TagName  string `json:"tag_name,optional"`
	TagValue string `json:"tag_value,optional"`
	TaggedAt int64  `json:"tagged_at,optional"`
}
type ObjectTagsResp {
	Tags []TagValueItem `json:"tags"`
}

@server(
	jwt: Auth
	group: tag
)



service datacenter-api {
	@doc(
		summary: "创建标签对象"
	)
	@handler createTagObject
	post /tag/object/create (CreateTagObjectReq) returns (TagObject)
	@doc(
		summary: "标签对象列表"
	)
	@handler tagObjectList
	get /tag/object/list (TagObjectListReq) returns (TagObjectListResp)
	@doc(
		summary: "删除标签对象（对象下仍有标签定义或人群时拒绝）"
	)
	@handler deleteTagObject
	post /tag/object/delete (TagDefIdReq)
	@doc(
		summary: "创建标签定义"
	)
	@handler createTagDef
	post /tag/def/create (CreateTagDefReq) returns (TagDef)
	@doc(
		summary: "标签定义列表"
	)
	@handler tagDefList
	get /tag/def/list (TagDefListReq) returns (TagDefListResp)
	@doc(
		summary: "更新标签定义"
	)
	@handler updateTagDef
	post /tag/def/update (UpdateTagDefReq) returns (TagDef)
	@doc(
		summary: "删除标签定义"
	)
	@handler deleteTagDef
	post /tag/def/delete (TagDefIdReq)
	@doc(
		summary: "执行打标"
	)
	@handler tagging
	post /tag/tagging (TaggingReq) returns (TaggingResp)
	@doc(
		summary: "对象标签画像"
	)
	@handler objectTags
	get /tag/object/tags (ObjectTagsReq) returns (ObjectTagsResp)
}

@server(
	jwt: Auth
	group: tag
)
service datacenter-api {
	@doc(
		summary: "创建人群"
	)
	@handler createTagGroup
	post /tag/group/create (CreateTagGroupReq) returns (TagGroupInfo)
	@doc(
		summary: "人群列表"
	)
	@handler tagGroupList
	get /tag/group/list (TagGroupListReq) returns (TagGroupListResp)
	@doc(
		summary: "删除人群"
	)
	@handler deleteTagGroup
	post /tag/group/delete (TagDefIdReq)
	@doc(
		summary: "执行圈选"
	)
	@handler runTagCircle
	post /tag/group/run (RunTagCircleReq) returns (RunTagCircleResp)
	@doc(
		summary: "人群成员"
	)
	@handler tagGroupMembers
	get /tag/group/members (GroupMembersReq) returns (GroupMembersResp)
}
