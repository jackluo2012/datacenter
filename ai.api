syntax = "v1"

//AI 问数（Phase 4：语义检索 + 可选 LLM，全程审计）
type Candidate {
	Type    string `json:"type,optional"` //entity/metric
	Id      int64  `json:"id,optional"`
	Name    string `json:"name,optional"`
	Detail  string `json:"detail,optional"`
	Comment string `json:"comment,optional"`
}

type AskReq {
	Question      string `json:"question"`
	Beid          int64  `json:"beid,optional"`
	MaxCandidates int32  `json:"max_candidates,optional"`
	ContextJson   string `json:"context_json,optional"` //多轮上下文（上一轮 question/SQL）
}

type AskResp {
	Candidates   []Candidate `json:"candidates"`
	LlmEnabled   bool        `json:"llm_enabled"`
	GeneratedSql string      `json:"generated_sql,optional"`
	Answer       string      `json:"answer"`
	CostMs       int64       `json:"cost_ms"`
}

type AskAndRunReq {
	Question      string `json:"question"`
	Beid          int64  `json:"beid,optional"`
	MaxCandidates int32  `json:"max_candidates,optional"`
	AutoRun       bool   `json:"auto_run,optional"` //生成 SQL 后经 ide 安全闸自动执行
	DatasourceId  int64  `json:"datasource_id,optional"` //auto_run 时必填：执行目标库
	MaxRows       int32  `json:"max_rows,optional"` //默认 20,上限 100
}

type AskAndRunResp {
	Candidates   []Candidate `json:"candidates"`
	LlmEnabled   bool        `json:"llm_enabled"`
	GeneratedSql string      `json:"generated_sql,optional"`
	Answer       string      `json:"answer"`
	CostMs       int64       `json:"cost_ms"`
	Executed     bool        `json:"executed"`
	ColumnsJson  string      `json:"columns_json,optional"`
	RowsJson     string      `json:"rows_json,optional"`
	RowCount     int64       `json:"row_count"`
	RunError     string      `json:"run_error,optional"`
}

@server (
	jwt:   Auth
	group: ai
)
service datacenter-api {
	@doc (
		summary: "AI 问数"
	)
	@handler ask
	post /ai/ask (AskReq) returns (AskResp)

	@doc (
		summary: "AI 问数并执行（LLM 生成 SQL 后经 ide 安全闸自动执行）"
	)
	@handler askAndRun
	post /ai/ask_and_run (AskAndRunReq) returns (AskAndRunResp)
}

