syntax = "v1"

//数据质量（Phase 2）
type QualityRule {
	Id            int64  `json:"id,optional"`
	Name          string `json:"name,optional"`
	RuleType      string `json:"rule_type,optional"`
	TargetTable   string `json:"target_table,optional"`
	TargetColumn  string `json:"target_column,optional"`
	ParamsJson    string `json:"params_json,optional"`
	ThresholdJson string `json:"threshold_json,optional"`
	Status        int32  `json:"status,optional"`
	Owner         string `json:"owner,optional"`
}

type CreateQualityRuleReq {
	Name          string `json:"name"`
	RuleType      string `json:"rule_type"`
	TargetTable   string `json:"target_table"`
	TargetColumn  string `json:"target_column,optional"`
	ParamsJson    string `json:"params_json,optional"`
	ThresholdJson string `json:"threshold_json,optional"`
	Owner         string `json:"owner,optional"`
	Beid          int64  `json:"beid,optional"`
}

type UpdateQualityRuleReq {
	Id            int64  `json:"id"`
	Name          string `json:"name"`
	RuleType      string `json:"rule_type"`
	TargetTable   string `json:"target_table"`
	TargetColumn  string `json:"target_column,optional"`
	ParamsJson    string `json:"params_json,optional"`
	ThresholdJson string `json:"threshold_json,optional"`
	Status        int32  `json:"status"` //1.启用 0.停用（全量更新契约，必传）
	Owner         string `json:"owner,optional"` //空则保留原负责人
	Beid          int64  `json:"beid,optional"`
}

type QualityIdReq {
	Id   int64 `json:"id,optional" form:"id,optional"`
	Beid int64 `json:"beid,optional" form:"beid,optional"`
}

type QualityRuleListReq {
	Beid     int64  `json:"beid,optional" form:"beid,optional"`
	RuleType string `json:"rule_type,optional" form:"rule_type,optional"`
	Page     int64  `json:"page,optional" form:"page,optional"`
	Size     int64  `json:"size,optional" form:"size,optional"`
}
type QualityRuleListResp {
	List  []QualityRule `json:"list"`
	Total int64         `json:"total"`
}

type CreateQualityJobReq {
	Name         string `json:"name"`
	DatasourceId int64  `json:"datasource_id"`
	DbName       string `json:"db_name,optional"`
	RuleIds      string `json:"rule_ids"`
	Cron         string `json:"cron,optional"`
	Beid         int64  `json:"beid,optional"`
}
type QualityJob {
	Id          int64  `json:"id,optional"`
	Name        string `json:"name,optional"`
	DatasourceId int64 `json:"datasource_id,optional"`
	DbName      string `json:"db_name,optional"`
	RuleIds     string `json:"rule_ids,optional"`
	Cron        string `json:"cron,optional"`
	LastStatus  string `json:"last_status,optional"`
	LastRunAt   int64  `json:"last_run_at,optional"`
	Beid        int64  `json:"beid,optional"`
}
type JobListReq {
	Beid int64 `json:"beid,optional" form:"beid,optional"`
	Page int64 `json:"page,optional" form:"page,optional"`
	Size int64 `json:"size,optional" form:"size,optional"`
}
type JobListResp {
	List  []QualityJob `json:"list"`
	Total int64        `json:"total"`
}

type RunJobResp {
	JobId      int64  `json:"job_id"`
	TotalRules int64  `json:"total_rules"`
	Passed     int64  `json:"passed"`
	LastStatus string `json:"last_status"`
}

type QualityResult {
	Id         int64  `json:"id,optional"`
	JobId      int64  `json:"job_id,optional"`
	RuleId     int64  `json:"rule_id,optional"`
	RuleType   string `json:"rule_type,optional"`
	CheckValue string `json:"check_value,optional"`
	PassFlag   bool   `json:"pass_flag,optional"`
	DetailJson string `json:"detail_json,optional"`
	RunAt      int64  `json:"run_at,optional"`
}
type ResultListReq {
	JobId      int64 `json:"job_id,optional" form:"job_id,optional"`
	PassFilter int64 `json:"pass_filter,optional" form:"pass_filter,optional"`
	Page       int64 `json:"page,optional" form:"page,optional"`
	Size       int64 `json:"size,optional" form:"size,optional"`
}
type ResultListResp {
	List  []QualityResult `json:"list"`
	Total int64           `json:"total"`
}

@server(
	jwt: Auth
	group: quality
)
service datacenter-api {
	@doc(
		summary: "创建质量规则"
	)
	@handler createQualityRule
	post /quality/rule/create (CreateQualityRuleReq) returns (QualityRule)
	@doc(
		summary: "更新质量规则"
	)
	@handler updateQualityRule
	post /quality/rule/update (UpdateQualityRuleReq) returns (QualityRule)
	@doc(
		summary: "删除质量规则"
	)
	@handler deleteQualityRule
	post /quality/rule/delete (QualityIdReq)
	@doc(
		summary: "质量规则列表"
	)
	@handler qualityRuleList
	get /quality/rule/list (QualityRuleListReq) returns (QualityRuleListResp)
	@doc(
		summary: "创建质量任务"
	)
	@handler createQualityJob
	post /quality/job/create (CreateQualityJobReq) returns (QualityJob)
	@doc(
		summary: "删除质量任务"
	)
	@handler deleteQualityJob
	post /quality/job/delete (QualityIdReq)
	@doc(
		summary: "质量任务列表"
	)
	@handler qualityJobList
	get /quality/job/list (JobListReq) returns (JobListResp)
	@doc(
		summary: "执行质量任务"
	)
	@handler runQualityJob
	post /quality/job/run (QualityIdReq) returns (RunJobResp)
	@doc(
		summary: "质量结果列表"
	)
	@handler qualityResultList
	get /quality/result/list (ResultListReq) returns (ResultListResp)
}

type AlertChannelInfo {
	Id          int64  `json:"id,optional"`
	Name        string `json:"name,optional"`
	Type        string `json:"type,optional"`
	WebhookUrl  string `json:"webhook_url,optional"`
	Secret      string `json:"secret,optional"`
	MinLevel    string `json:"min_level,optional"`
	Status      int32  `json:"status,optional"`
}
type SaveAlertChannelReq {
	Name        string `json:"name"`
	Type        string `json:"type"`
	WebhookUrl  string `json:"webhook_url"`
	Secret      string `json:"secret,optional"`
	MinLevel    string `json:"min_level,optional"`
	Beid        int64  `json:"beid,optional"`
}
type AlertChannelListReq {
	Beid int64 `json:"beid,optional" form:"beid,optional"`
	Page int64 `json:"page,optional" form:"page,optional"`
	Size int64 `json:"size,optional" form:"size,optional"`
}
type AlertChannelListResp {
	List  []AlertChannelInfo `json:"list"`
	Total int64              `json:"total"`
}
type TestAlertResp {
	Ok  bool   `json:"ok"`
	Msg string `json:"msg,optional"`
}
type QualityErrorData {
	RuleId      int64  `json:"rule_id,optional"`
	JobId       int64  `json:"job_id,optional"`
	RowsJson    string `json:"rows_json,optional"`
	SampleCount int32  `json:"sample_count,optional"`
	RunAt       int64  `json:"run_at,optional"`
}
type ErrorDataListReq {
	JobId  int64 `json:"job_id,optional" form:"job_id,optional"`
	RuleId int64 `json:"rule_id,optional" form:"rule_id,optional"`
	Page   int64 `json:"page,optional" form:"page,optional"`
	Size   int64 `json:"size,optional" form:"size,optional"`
}
type ErrorDataListResp {
	List  []QualityErrorData `json:"list"`
	Total int64              `json:"total"`
}
type TableProfileInfo {
	Id           int64   `json:"id,optional"`
	DatasourceId int64   `json:"datasource_id,optional"`
	TableName    string  `json:"table_name,optional"`
	RowsCnt      int64   `json:"rows_cnt,optional"`
	ColsCnt      int32   `json:"cols_cnt,optional"`
	NullRate     float64 `json:"null_rate,optional"`
	DupPkCnt     int64   `json:"dup_pk_cnt,optional"`
	HealthScore  int32   `json:"health_score,optional"`
	ProfileJson  string  `json:"profile_json,optional"`
	RunAt        int64   `json:"run_at,optional"`
}
type ProfileTableReq {
	DatasourceId int64  `json:"datasource_id"`
	Beid         int64  `json:"beid,optional"`
	DbName       string `json:"db_name,optional"`
	TableName    string `json:"table_name"`
	PkColumn     string `json:"pk_column,optional"`
}
type ProfileResp { Profile TableProfileInfo `json:"profile"` }
type ProfileListQReq {
	Beid         int64  `json:"beid,optional" form:"beid,optional"`
	DatasourceId int64  `json:"datasource_id,optional" form:"datasource_id,optional"`
	TableName    string `json:"table_name,optional" form:"table_name,optional"`
	Page         int64  `json:"page,optional" form:"page,optional"`
	Size         int64  `json:"size,optional" form:"size,optional"`
}
type ProfileListResp {
	List  []TableProfileInfo `json:"list"`
	Total int64              `json:"total"`
}

@server(
	jwt: Auth
	group: quality
)
service datacenter-api {
	@handler saveAlertChannel
	post /quality/alertchannel/save (SaveAlertChannelReq) returns (AlertChannelInfo)
	@handler deleteAlertChannel
	post /quality/alertchannel/delete (QualityIdReq)
	@handler alertChannelList
	get /quality/alertchannel/list (AlertChannelListReq) returns (AlertChannelListResp)
	@handler testAlertChannel
	post /quality/alertchannel/test (QualityIdReq) returns (TestAlertResp)
	@handler qualityErrorDataList
	get /quality/errordata/list (ErrorDataListReq) returns (ErrorDataListResp)
	@handler profileTable
	post /quality/profile/table (ProfileTableReq) returns (ProfileResp)
	@handler qualityProfileList
	get /quality/profile/list (ProfileListQReq) returns (ProfileListResp)
}
